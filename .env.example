# =============================================================
# PDF / DOCX Quiz — Environment Variables
# =============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Security ──────────────────────────────────────────────────
# Flask session secret. Use a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret

# ── Database ──────────────────────────────────────────────────
# Full PostgreSQL DSN. Leave empty to use SQLite (default: app.db).
DATABASE_URL=

# Path to the SQLite database file (used only when DATABASE_URL is empty).
DB_PATH=app.db

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
DEBUG=0
